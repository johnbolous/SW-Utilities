# Server-only. The browser never talks to Supabase directly in this
# architecture — every request goes through Next.js API routes, which use
# the service role key. Do NOT prefix these with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# NEXT_PUBLIC_SUPABASE_URL is intentionally public-prefixed even though only
# server code uses it here — it's not a secret (it's just your project's
# base URL), and keeping the same variable name as Supabase's own docs
# avoids confusion if you ever add a browser-side Supabase feature later.
